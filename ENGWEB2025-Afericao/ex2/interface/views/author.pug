extends layout 

block content
    .w3-card-4 
        header.w3-container.w3-teal
            h1= idAutor

    .w3-container 
        table.w3-table-all 
            tr 
                th Id 
                th Title 
                th Author
                th Publish Date 
                th Pages

            each book in books 
                tr 
                    td 
                        a(href='/' + book._id)= book._id 
                    td= book.title 
                    td= book.author
                    td= book.publishDate 
                    td= book.pages

        p Total de livros: #{books.length}

    footer.w3.container.w3-teal 
        a.w3-btn.w3-red.w3-round(href="/") Voltar
        br
        adress Generated by EngWeb2025