extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= title
  
    .w3-container
      ul.w3-ul.w3-card-4
        li 
          b Id: #{book._id}
        li
          b Title: #{book.title}
        li 
          b Series: #{book.series}
        li 
          b Author: #{book.author}
        li 
          b Rating: #{book.rating}
        li 
          b Description: #{book.description}
        li 
          b Language: #{book.language}
        li 
          b ISBN: #{book.isbn}
        li 
          b Genres: #{book.genres}
        li 
          b Characters: #{book.characters}
        li 
          b Book Format: #{book.bookFormat}
        li 
          b Edition: #{book.edition}
        li 
          b Pages: #{book.pages}
        li 
          b Publisher: #{book.publisher}
        li 
          b Publish Date: #{book.publishDate}
        li 
          b First Publish Date: #{book.firstPublishDate}
        li 
          b Awards: #{book.awards}
        li 
          b Number of Ratings: #{book.numRatings}
        li 
          b Ratings By Stars: #{book.ratingsByStars}
        li 
          b Liked Percentage: #{book.likedPercentage}
        li 
          b Setting: #{book.setting}
        li 
          b BBE Score: #{book.bbeScore}
        li 
          b BBE Votes: #{book.bbeVotes}
        li 
          b Price: #{book.price}
        li 
          b Cover Image: 
            br
            br
            img(src=book.coverImg)

        footer.w3.container.w3-teal 
            a.w3-btn.w3-red.w3-round(href="/") Voltar
