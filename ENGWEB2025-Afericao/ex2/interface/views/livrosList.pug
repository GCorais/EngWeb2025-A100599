extends layout

block content 
    .w3-card-4
        header.w3-container.w3-teal
            h1
                span Books List 

        .w3-container
            table.w3-table-all
                tr
                    th Id 
                    th Title
                    th Author
                    th Publish Date
                    th Pages
                each livro in llist
                    tr
                        td
                            a(href="/" + livro._id)= livro._id
                        td= livro.title
                        td
                            a(href="/entidades/" + livro.author)= livro.author
                        td= livro.publishDate
                        td= livro.pages

            footer.w3.container.w3-blue 
                adress Generated by EngWeb2025