extends layout

block content
    .w3-card-4
        header.w3-container.w3-blue
            h2 Film Form 
        form.w3-container(method="POST")
            fieldset
                label Id
                input.w3-input.w3-round(type="text" name="id" readonly value=filme.id) 
                label Ano
                input.w3-input.w3-round(type="text" name="year" value=filme.year required)
                label Título
                input.w3-input.w3-round(type="text" name="title" value=filme.title required)
            fieldset 
                legend Elenco
                    each actor in filme.cast
                        input.w3-input.w3-round(type="text" name="cast" value=actor required)
            fieldset 
                legend Géneros
                    each genre in filme.genres
                        input.w3-input.w3-round(type="text" name="genres" value=genre required)
            br
            button.w3-btn.w3-blue.w3-mb-2(type="submit") Edit
    footer.w3-container.w3-blue
      address Generated by EW2025 class