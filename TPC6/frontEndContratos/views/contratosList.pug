extends layout

block content 
    .w3-card-4
        header.w3-container.w3-teal
            h1
                span Contracts List 

        .w3-container
            table.w3-table-all
                tr
                    th Id 
                    th ObjectoContrato
                    th DataCelebracaoContrato
                    th PrecoContratual
                    th NIPC_entidade_comunicante
                    th Entidade_comunicante
                each contrato in clist
                    tr
                        td
                            a(href="/" + contrato._id)= contrato._id
                        td= contrato.objectoContrato
                        td= contrato.dataCelebracaoContrato
                        td= contrato.precoContratual
                        td
                            a(href="/entidades/" + contrato.NIPC_entidade_comunicante)= contrato.NIPC_entidade_comunicante
                        td= contrato.entidade_comunicante

            footer.w3.container.w3-blue 
                adress Generated by EngWeb2025