extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= title
  
    .w3-container
      ul.w3-ul.w3-card-4
        li 
          b Id: #{contrato._id}
        li
          b Anúncio: #{contrato.nAnuncio}
        li 
          b Tipo Procedimento: #{contrato.tipoprocedimento}
        li 
          b Objeto de Contrato: #{contrato.objectoContrato}
        li 
          b Data de Publicação: #{contrato.dataPublicacao}
        li 
          b Data de Celebração de Contrato: #{contrato.dataCelebracaoContrato}
        li 
          b Preço Contratual: #{contrato.precoContratual}
        li 
          b Prazo de Execução: #{contrato.prazoExecucao}
        li 
          b NIPC da Entidade Comunicante: #{contrato.NIPC_entidade_comunicante}
        li 
          b Entidade Comunicante: #{contrato.entidade_comunicante}
        li 
          b Fundamentação: #{contrato.fundamentacao}

        footer.w3.container.w3-teal 
            a.w3-btn.w3-red.w3-round(href="/") Voltar
            br
            adress Generated by EngWeb2025