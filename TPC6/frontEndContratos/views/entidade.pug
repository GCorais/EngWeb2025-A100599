extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= title

    .w3-container
      ul.w3-ul.w3-card-4
        li 
          b Id: #{nipc}
        li 
          b Nome da Entidade: #{entidade}

        table.w3-table-all
                tr
                    td 
                        b Id 
                    td 
                        b Tipo de procedimento
                    td 
                        b Objecto Contrato
                    td 
                        b Data Celebracao Contrato
                    td 
                        b Preco Contratual
                each contrato in clist
                    tr
                        td= contrato._id
                        td= contrato.tipoprocedimento 
                        td= contrato.objectoContrato
                        td= contrato.dataCelebracaoContrato
                        td= contrato.precoContratual
        li 
          b Somatório do valor dos contratos: #{sum}

        footer.w3.container.w3-teal 
            a.w3-btn.w3-red.w3-round(href="/") Voltar
            br
            adress Generated by EngWeb2025