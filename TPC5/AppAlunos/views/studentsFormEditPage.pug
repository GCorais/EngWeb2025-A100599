extends layout

block content
    .w3-card-4
        header.w3-container.w3-teal
            h2 Student Form 
        form.w3-container(method="POST")
            fieldset 
                legend Metadata 
                label Id 
                input.w3-input.w3-round(type="text" name="id" readonly value=aluno._id)
                label Name 
                input.w3-input.w3-round(type="text" name="nome" value=aluno.nome)
                label NamGite 
                input.w3-input.w3-round(type="text" name="gitlink" value=aluno.gitlink)
            fieldset 
                legend TPC

                each val, i in [1,2,3,4,5,6,7,8]
                    - var key = 'tpc' + val
                    label
                    if aluno[key]
                        input.w3-check(type="checkbox", name=key, checked)
                    else
                        input.w3-check(type="checkbox", name=key)
                    | TPC #{val}

            br
            button.w3-btn.w3-teal.w3-mb-2(type="submit") Edit