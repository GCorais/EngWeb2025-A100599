extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1
        span #{aluno.nome}
  
    .w3-container
      ul.w3-ul.w3-card-4
        li 
          b Número: #{aluno._id}
        li
          b Nome: #{aluno.nome}
        li
          b Git (link): 
          a(href=aluno.gitlink) #{aluno.gitlink}

    .w3-container
      h3 TPCs feitos:
      ul.w3-ul
        each i in [1,2,3,4,5,6,7,8]
          - var key = 'tpc' + i
          if aluno[key]
            li TPC#{i}